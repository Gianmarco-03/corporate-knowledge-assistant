# spikes/.env.example — chiavi degli spike della fase 1 (WIRING W6). Proprietario: 01-02.
#
# Questo file NON contiene valori segreti e non si usa per le misure: i valori reali stanno
# nel file esterno $HOME/.cka-spikes/spikes.env (variabile CKA_SPIKES_ENV), fuori dal repo
# e dai worktree, passato con `docker compose --env-file "$CKA_SPIKES_ENV"`; negli script
# host `set -a; . "$CKA_SPIKES_ENV"; set +a`. Mai creare spikes/.env.
#
# Ogni slice aggiunge chiavi solo in coda alla propria sezione, con valore vuoto o non
# segreto. COMPOSE_PROFILES e CKA_RUN_ID non vanno mai in questo file né in spikes.env.
# Segreti e URL interni sono vuoti: la forma è nel commento sopra la chiave.
#
# Modifica: Claude (gsd-executor 01.6-03) · 2026-10-27 · EMBED_MODEL=BAAI/bge-m3, revisioni TEI obbligatorie (gap-closure 1.6, D-09)

# common
HW_LABEL=

# s01
POSTGRES_USER=
POSTGRES_PASSWORD=
# forma: postgres://<utente>:<password>@postgres:5432/spikes
DATABASE_URL=
GARAGE_RPC_SECRET=
# forma: GK + 24 caratteri esadecimali
GARAGE_ACCESS_KEY=
GARAGE_SECRET_KEY=
# forma: http://garage:3900
S3_ENDPOINT=
S3_BUCKET=cka-originals
# forma: http://cka-s01-server:8080/upload (job del runner avviato da 01-04)
S01_TARGET_URL=

# s02
PDFIUM_DIR=/opt/pdfium/lib
# forma: http://docling:5001
DOCLING_URL=
# forma: http://docling-cpu:5001
DOCLING_CPU_URL=
DOCLING_NUM_THREADS=8
# percorso dei pesi offline nel container Docling; si sovrascrive solo per la prova
# negativa di 01-02 (Task 3)
DOCLING_ARTIFACTS_PATH=/models

# s03
EMBED_MODEL=BAAI/bge-m3
# obbligatoria: compose rifiuta il valore vuoto (gap-closure 1.6, D-09); va nel file segreti con lo sha del commit Hugging Face (ADR-0007)
EMBED_REVISION=
# forma: http://tei-embed:80
TEI_EMBED_URL=
TEI_EMBED_DTYPE=float16
TEI_MAX_BATCH_TOKENS=16384
TEI_MAX_CLIENT_BATCH=64

# s04
JEV_API_URL=https://api.typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# forma: http://tei-rerank:80
TEI_RERANK_URL=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# obbligatoria: compose rifiuta il valore vuoto (gap-closure 1.6, D-09); va nel file segreti con lo sha del commit Hugging Face (RISULTATI-rerank.md)
RERANK_REVISION=
TEI_RERANK_MAX_BATCH_TOKENS=8192
S04_MAX_COST_USD=5

# s05
S05_JEV_CANCEL_REQUESTS=20

# s06
ANTHROPIC_API_KEY=
LLM_MODEL_SIMPLE=claude-haiku-5-5
LLM_MODEL_COMPLEX=claude-sonnet-5-5
S06_MAX_COST_USD=5
